{
  "name": "cw-handsoff-sys",
  "version": "0.1.2",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "author": {
    "name": "Chan Woo Cho",
    "email": "ccw00325@gmail.com",
    "url": "https://github.com/ccw00325-spec"
  },
  "description": "Local multi-AI engineering workbench with role-based delegation.",
  "type": "module",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "version:next": "node scripts/release-version.mjs --next",
    "test": "node --test test/*.test.js",
    "check": "node scripts/check.mjs",
    "check:dependencies": "node scripts/check-build-dependencies.mjs",
    "package:win": "electron-builder --win portable",
    "package:mac": "electron-builder --mac dmg zip --publish never --config.directories.output=release-mac",
    "sync:platforms": "node scripts/sync-platforms.mjs",
    "postpackage:win": "node scripts/verify-package.mjs && node scripts/prune-release.mjs",
    "icon:build": "electron scripts/build-icon.mjs",
    "test:desktop": "node scripts/smoke-v07.mjs",
    "test:timer:live": "node scripts/simulate-timer.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "test:timer:qa:live": "node scripts/simulate-timer.mjs --qa",
    "test:chat:live": "node scripts/check-live-chat.mjs"
  },
  "dependencies": {
    "jose": "6.2.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "electron": "45.2.3",
    "electron-builder": "^26.0.12"
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "11.0.1"
  },
  "build": {
    "appId": "dev.agent.controltower",
    "productName": "CW_Handsoff_sys",
    "files": [
      "LICENSE",
      "NOTICE",
      "src/*.js",
      "src/*.cjs",
      "src/core/*.js",
      "src/renderer/*.js",
      "src/renderer/*.css",
      "src/renderer/index.html",
      "src/renderer/splash.html",
      "src/renderer/assets/mascot.png",
      "src/renderer/assets/provider-*.svg",
      "src/renderer/assets/providers-NOTICE.txt",
      "src/renderer/assets/guide/*.png",
      "src/skills/fun.md",
      "src/skills/gemini-readonly.toml",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "icon": "build/app.ico",
      "extraResources": [
        {
          "from": "build/app.ico",
          "to": "app.ico"
        }
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "icon": "src/renderer/assets/mascot.png",
      "identity": "-",
      "hardenedRuntime": true,
      "artifactName": "CW_Handsoff_sys-${version}-Mac-${arch}.${ext}"
    },
    "directories": {
      "output": "release"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    }
  },
  "productName": "CW_Handsoff_sys"
}
